{
	"Function Main": {
		"prefix": "main",
		"body": [
			"fn main() {",
			"\t$1",
			"}"
		],
		"description": "主函数"
	},
	"Function": {
		"prefix": "fn",
		"body": [
			"fn ${1:name}(${2:params}) -> ${3:return_type} {",
			"\t$4",
			"}"
		],
		"description": "普通函数"
	},
	"Macro Println": {
		"prefix": "pr",
		"body": [
			"println!(\"${1:text}\");"
		],
		"description": "println! 宏"
	},
	"Macro Println Debug": {
		"prefix": "db",
		"body": [
			"dbg!($1);"
		],
		"description": "dbg! 宏"
	},
	"Macro Vec": {
		"prefix": "vec",
		"body": [
			"let ${1:name} = vec![${2:value}];"
		],
		"description": "Vec! 宏"
	},
	"Struct": {
		"prefix": "struct",
		"body": [
			"struct ${1:Name} {",
			"\t${2:field}: ${3:type},",
			"}"
		],
		"description": "结构体定义"
	},
	"Enum": {
		"prefix": "enum",
		"body": [
			"enum ${1:Name} {",
			"\t${2:Variant},",
			"}"
		],
		"description": "枚举定义"
	},
	"Impl": {
		"prefix": "impl",
		"body": [
			"impl ${1:Name} {",
			"\t$2",
			"}"
		],
		"description": "为结构体或枚举实现方法"
	},
	"Trait": {
		"prefix": "trait",
		"body": [
			"trait ${1:Name} {",
			"\tfn ${2:method_name}(&self) -> ${3:return_type};",
			"}"
		],
		"description": "Trait 定义"
	},
	"Loop": {
		"prefix": "loop",
		"body": [
			"loop {",
			"\t$1",
			"}"
		],
		"description": "无限循环"
	},
	"For Loop": {
		"prefix": "for",
		"body": [
			"for ${1:item} in ${2:iterator} {",
			"\t$3",
			"}"
		],
		"description": "for 循环"
	},
	"If Statement": {
		"prefix": "if",
		"body": [
			"if ${1:condition} {",
			"\t$2",
			"} else {",
			"\t$3",
			"}"
		],
		"description": "if-else 语句"
	},
	"Match": {
		"prefix": "match",
		"body": [
			"match ${1:value} {",
			"\t${2:pattern} => ${3:expression},",
			"\t_ => ${4:default_expression}",
			"}"
		],
		"description": "match 语句"
	},
	"Result Ok Err": {
		"prefix": "res",
		"body": [
			"fn ${1:name}() -> Result<${2:OkType}, ${3:ErrType}> {",
			"\tOk(${4:value})",
			"}"
		],
		"description": "返回 Result 的函数"
	},
	"Option Some None": {
		"prefix": "opt",
		"body": [
			"let ${1:name}: Option<${2:Type}> = Some(${3:value});",
			"// let ${4:name}: Option<${5:Type}> = None;"
		],
		"description": "Option 类型"
	}
}
