{
	"Python Function (Modern)": {
		"prefix": "func",
		"body": [
			"def ${1:function_name}(${2:args}: ${3:Any}) -> ${4:None}:",
			"\t\"\"\"${5:Description}\"\"\"",
			"\t$0"
		],
		"description": "带有类型提示和文档字符串的现代函数定义"
	},
	"If Main Block": {
		"prefix": "ifmain",
		"body": [
			"def main() -> None:",
			"\t$0",
			"",
			"if __name__ == \"__main__\":",
			"\tmain()"
		],
		"description": "更规范的 if main 结构（通过 main 函数入口）"
	},
	"Python File Header": {
		"prefix": "!",
		"body": [
			"#!/usr/bin/env python3",
			"# -*- coding: utf-8 -*-",
			"\"\"\"",
			"File: ${RELATIVE_FILEPATH}",
			"Author: Xing Ji",
			"Date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
			"Description: ${1:Detailed description of the module's purpose.}",
			"\"\"\""
		],
		"description": "基于 PEP 257 规范的模块级文档字符串 (项目相对路径版)"
	},
	"Read JSONL (Line-Delimited JSON)": {
		"prefix": "rj",
		"body": [
			"import json",
			"from pathlib import Path",
			"",
			"file_path = Path(${1:\"data.jsonl\"})",
			"with file_path.open(\"r\", encoding=\"utf-8\") as f:",
			"\tfor line in f:",
			"\t\tif not line.strip(): continue",
			"\t\titem = json.loads(line)",
			"\t\t$0"
		],
		"description": "高性能读取 JSONL 文件（逐行处理，节省内存）"
	},
	"Write JSONL": {
		"prefix": "wj",
		"body": [
			"import json",
			"from pathlib import Path",
			"",
			"output_path = Path(${1:\"output.jsonl\"})",
			"with output_path.open(\"w\", encoding=\"utf-8\") as f:",
			"\tfor item in ${2:data_list}:",
			"\t\tf.write(json.dumps(item, ensure_ascii=False) + \"\\n\")",
			"$0"
		],
		"description": "规范写入 JSONL（内存友好型）"
	}
}
