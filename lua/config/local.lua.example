-- ===========================================================================
-- 本机专属配置模板
-- ===========================================================================
-- 复制为 lua/config/local.lua（已在 .gitignore 中忽略，不会被提交）。
-- 由 lua/config/base.lua 末尾 pcall(require, "config.local") 加载，
-- 文件不存在时安静跳过，不影响其他机器。

-- 代理：按需修改成当前机器的代理地址，不需要则整段删掉/注释掉。
-- vim.env.http_proxy = "http://127.0.0.1:1082"
-- vim.env.https_proxy = "http://127.0.0.1:1082"
